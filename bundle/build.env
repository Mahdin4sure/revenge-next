# Build configuration for official builds. Committed so builds are reproducible.
# Override values locally in .env (ignored by Gradle builds, which pass --reproducible).

REVENGE_DISCORD_SERVER_URL=https://discord.com/invite/dtBTQHYSx4
REVENGE_SOURCE_REPOSITORY_URL=https://github.com/Valenced/valenced
REVENGE_LICENSE_URL=https://raw.githubusercontent.com/Valenced/valenced/main/LICENSE

# Required while any bundled plugin is a stub with a default source.
REVENGE_DEFAULT_PLUGIN_REPOSITORY_URL=https://community.valenced.app/index.json

# Optional
REVENGE_DONATE_URL=https://github.com/sponsors/Valenced
